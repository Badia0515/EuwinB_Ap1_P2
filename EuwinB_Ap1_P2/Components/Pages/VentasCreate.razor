@page "/Venta/Create"
@inject ProductoServices productoService
@inject VentaServices VentaServices
@inject NavigationManager navegacion
@rendermode InteractiveServer
<EditForm Model="VentaEntrada" OnValidSubmit="Guardar" FormName="Entrada">
    <DataAnnotationsValidator/>
    <div class="container">
        <div class="card border-3">
            <div class="mb-3">
                <label>Fecha</label>
                <InputDate @bind-Value="VentaEntrada.Fecha"/>
                <ValidationMessage For="@(()=>VentaEntrada.Fecha)"/>
            </div>
            <div class="mb-3">
                <label>Observacion</label>
                <InputText @bind-Value="VentaEntrada.Observacion" />
                <ValidationMessage For="@(()=>VentaEntrada.Observacion)" />
            </div>
            <div class="card border-3">
                <ProductoPicker productos="productos" OnProductoSelect="handleProducto"/>
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <td>Id</td>
                            <td>Cantidad</td>
                            <td>Precio</td>
                            <td>Opciones</td>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var Detalle in VentaEntrada.ventaDetalles)
                        {
                            <tr>
                                <td>@Detalle.ProductoId</td>
                                <td>@Detalle.Cantidad</td>
                                <td>@Detalle.Precio</td>
                                <td>
                                    <button class="btn btn-danger"type="button"@onclick="() => Eliminar(Detalle)">Eliminar</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="btn btn-center">
                <button class="btn btn-primary" type="submit">Guardar</button>
                <button class="btn btn-warning" type="button" @onclick="Navegacion">Consultar</button>
            </div>
        </div>
    </div>
</EditForm>
@if (!string.IsNullOrEmpty(Error))
{
    <div class="alert alert-danger" role="alert">
        @Error
    </div>
}
@code {
    public List<Productos> productos { get; set; } = [];
    public Venta VentaEntrada { get; set; } = new();
    public VentaDetalle Detalle { get; set; } = new();
    public string Error { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var result = await productoService.GetList(R => R.Activo);
        if (result.IsSuccess)
        {
            productos = result.Value;
        }
    }
    public async Task handleProducto((Productos producto, int Cantidad) Seleccionar)
    {
        var entrada = VentaEntrada.ventaDetalles.Any(E => E.ProductoId == Seleccionar.producto.ProductoId);
        if (entrada)
        {
            Error = "Ya fue Registrado";
            return;
        }
        var Detalle = new VentaDetalle()
        {
            ProductoId = Seleccionar.producto.ProductoId,
            Cantidad = Seleccionar.Cantidad,
            Precio = Seleccionar.producto.Precio
        };
        VentaEntrada.ventaDetalles.Add(Detalle);
        await Task.CompletedTask;
    }
    public async Task Guardar()
    {
        if (VentaEntrada.ventaDetalles == null || !VentaEntrada.ventaDetalles.Any())
        {
            Error = "Debes de registrar el detalle";
            return;
        }
        VentaEntrada.Total = VentaEntrada.ventaDetalles.Sum(E => E.Cantidad * E.Precio);
        var result = await VentaServices.Guardar(VentaEntrada);
    }

    public void Eliminar(VentaDetalle detalle)
    {
        VentaEntrada.ventaDetalles.Remove(detalle);
        Detalle = detalle;
    }

    public void Navegacion()
    {
        navegacion.NavigateTo("/Venta/index");
    }
}
