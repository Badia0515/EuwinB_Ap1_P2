@page "/Producto/Index"
@inject ProductoServices productoServices
@inject NavigationManager navegacion
@rendermode InteractiveServer
<div class="container">
    <div class="d-flex justify-content-between">
        <h4>Productos</h4>
        <button class="btn btn-primary bi bi-plus" @onclick="Crear">Crear Venta</button>
    </div>
    @*Filtrar*@
    <div class="card border-3">
        <div class="d-flex" style="gap:200px">
            <h6>Filtrar Por</h6>
            <h6>Busqueda</h6>
        </div>
        <div class="d-flex gap-5">
            <select style="width:200px; height:40px" @bind="Filtrar">
                <option value="">Seleccione</option>
                <option value="ProductoId">ProductoId</option>
            </select>
            <input type="text" placeholder="Buscar"style="width:200px; height:40px" @bind="FiltrarValor" />
            <button class="btn btn-warning bi bi-search"style="height:40px" @onclick="Filtro">
            </button>
        </div>
    </div>
    <div class="card border-3 mt-3">
        <QuickGrid Items="Entrada.AsQueryable()" Class="table table-bordered">
            <PropertyColumn Property="P => P.ProductoId" Title="ProductoId" Sortable="true" />
            <PropertyColumn Property="P => P.Nombre" Title="Nombre" Sortable="true" />
            <PropertyColumn Property="P => P.Concepto" Title="Concepto" Sortable="true" />
            <PropertyColumn Property="P => P.Precio" Title="Precio" Sortable="true" />
            <PropertyColumn Property="P => P.Stock" Title="Stock" Sortable="true" />
            <PropertyColumn Property="P => P.Activo" Title="Activo" Sortable="true"/>
        </QuickGrid>
    </div>

    <div>
        <label>Registro Total: @Entrada.Count()</label>
    </div>
</div>
@code {
    public List<Productos> Entrada { get; set; } = [];
    public string FiltrarValor { get; set; } = string.Empty;
    public string Filtrar { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var result = await productoServices.GetList(R => true);
        if (result.IsSuccess)
        {
            Entrada = result.Value;
        }

    }
    public async Task Filtro()
    {
        if (FiltrarValor.Trim() != "")
        {
            if (Filtrar == "ProductoId")
            {
                int.TryParse(FiltrarValor, out int id);
                var result = await productoServices.GetList(P => P.ProductoId == id);
                Entrada = result.Value;
            }
        }
          
    }
    public void Crear()
    {
        navegacion.NavigateTo($"/Venta/Create");
    }
}

